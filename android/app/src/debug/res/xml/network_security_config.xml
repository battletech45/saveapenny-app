<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug-only: allow plaintext HTTP so `flutter run` can reach a locally
  served backend (emulator host alias 10.0.2.2, or the dev machine's LAN IP
  for physical devices). This source set is never merged into release/profile
  builds, so production still requires HTTPS.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system"/>
        </trust-anchors>
    </base-config>
</network-security-config>
