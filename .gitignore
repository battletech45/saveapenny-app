# =============================================================================
# SaveAPenny Mobile — .gitignore
# Flutter (mobile) + freezed/json/riverpod codegen + l10n + secure secrets.
# =============================================================================

# -----------------------------------------------------------------------------
# Dart & Flutter tooling
# -----------------------------------------------------------------------------
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
build/
.fvm/flutter_sdk
.flutter-versions

# Symbolication / obfuscation output
app.*.symbols
app.*.map.json

# -----------------------------------------------------------------------------
# Generated code  —  ADR-0006 decision point
# -----------------------------------------------------------------------------
# Default = Option A: ignore generated code, regenerate via build_runner/CI.
# Your CI always runs codegen, so this is safe. If you switch to Option B
# (commit generated files), DELETE this whole block and commit the artifacts.
*.g.dart
*.freezed.dart
*.config.dart
*.gr.dart
*.mocks.dart
devtools_options.yaml

# Generated localizations (l10n.yaml -> output-dir: lib/l10n/generated)
lib/l10n/generated/
# Untranslated-messages report (l10n.yaml -> untranslated-messages-file)
lib/l10n/untranslated.txt

# -----------------------------------------------------------------------------
# Secrets & environment  (finance app — never commit these)
# -----------------------------------------------------------------------------
.env
.env.*
!.env.example
dart_define/*.json
!dart_define/*.example.json
*.pem
*.p12
*.key
secrets.dart
**/android/key.properties
**/android/**/*.jks
**/android/**/*.keystore
**/ios/**/*.mobileprovision
**/ios/**/ExportOptions.plist

# -----------------------------------------------------------------------------
# IDEs & editors
# -----------------------------------------------------------------------------
.idea/
*.iml
*.ipr
*.iws
.vscode/*
!.vscode/launch.json
!.vscode/settings.json
!.vscode/extensions.json
*.swp
*.swo
*~

# -----------------------------------------------------------------------------
# OS cruft
# -----------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# -----------------------------------------------------------------------------
# Android
# (gradlew, gradlew.bat, gradle-wrapper.jar/.properties ARE committed)
# -----------------------------------------------------------------------------
**/android/.gradle/
**/android/captures/
**/android/local.properties
**/android/**/GeneratedPluginRegistrant.java
**/android/key.properties
**/android/app/debug/
**/android/app/profile/
**/android/app/release/
*.jks
*.keystore

# -----------------------------------------------------------------------------
# iOS
# (Podfile.lock IS committed for apps — not ignored here)
# -----------------------------------------------------------------------------
**/ios/**/*.mode1v3
**/ios/**/*.mode2v3
**/ios/**/*.moved-aside
**/ios/**/*.pbxuser
**/ios/**/*.perspectivev3
**/ios/**/*sync/
**/ios/**/.sconsign.dblite
**/ios/**/.tags*
**/ios/**/.vagrant/
**/ios/**/DerivedData/
**/ios/**/Icon?
**/ios/**/Pods/
**/ios/**/.symlinks/
**/ios/**/profile
**/ios/**/xcuserdata/
**/ios/.generated/
**/ios/Flutter/.last_build_id
**/ios/Flutter/App.framework
**/ios/Flutter/Flutter.framework
**/ios/Flutter/Flutter.podspec
**/ios/Flutter/Generated.xcconfig
**/ios/Flutter/ephemeral/
**/ios/Flutter/app.flx
**/ios/Flutter/app.zip
**/ios/Flutter/flutter_assets/
**/ios/Flutter/flutter_export_environment.sh
**/ios/ServiceDefinitions.json
**/ios/Runner/GeneratedPluginRegistrant.*

# -----------------------------------------------------------------------------
# macOS / Windows / Linux desktop (ephemeral — harmless if you don't target them)
# -----------------------------------------------------------------------------
**/macos/Flutter/GeneratedPluginRegistrant.swift
**/macos/Flutter/ephemeral/
**/windows/flutter/generated_plugin_registrant.*
**/windows/flutter/ephemeral/
**/linux/flutter/generated_plugin_registrant.*
**/linux/flutter/ephemeral/

# -----------------------------------------------------------------------------
# Testing & coverage
# -----------------------------------------------------------------------------
coverage/
*.lcov
test/.test_coverage.dart
# golden_toolkit failure artifacts (keep committed goldens, ignore failures)
**/failures/

# -----------------------------------------------------------------------------
# Misc
# -----------------------------------------------------------------------------
*.log
*.class
.history/
migrate_working_dir/